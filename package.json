{
    "name": "gendouyun_web_server",
    "version": "0.0.2",
    "description": "跟斗云导航（Koa 服务端 + Vue 3 前端）",
    "private": true,
    "main": "server.js",
    "workspaces": [
        "client"
    ],
    "scripts": {
        "start": "cross-env NODE_ENV=production node server.js",
        "dev": "npm run dev -w client",
        "build": "npm run build -w client"
    },
    "author": "Arleigh",
    "license": "GPL-3.0",
    "engines": {
        "node": ">=24.22.3",
        "npm": ">=11.19.1"
    },
    "config": {
        "vd": "/",
        "port": 3000,
        "env": "dev"
    },
    "dependencies": {
        "@koa/router": "^15.7.1",
        "cross-env": "^10.1.0",
        "helmet": "^8.3.0",
        "koa": "^3.3.0",
        "koa-bodyparser": "^4.4.1",
        "koa-helmet": "^9.0.0",
        "koa-static-cache": "^5.1.4",
        "lru-cache": "^11.5.3"
    }
}
